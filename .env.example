# joshua421 — your own credentials (dogfood: just you, your own tokens)

# Google OAuth — Calendar (read/write events) + Gmail (send only; never reads your inbox)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mint this once by running:  npm run auth
GOOGLE_REFRESH_TOKEN=
# Your own address — reflections are sent to/from here
GOOGLE_USER_EMAIL=

# Anthropic — the reflector that writes the reflections
ANTHROPIC_API_KEY=

# Where the behaviour log (records only) lives on this machine
JOSHUA421_DB=./joshua421.sqlite
# Your goals / grounding — the one piece of content stored (yours, editable by hand)
GROUNDING_PATH=./grounding.md
