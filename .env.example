# joshua421 — your own credentials (dogfood: just you, your own tokens)
#
# You usually don't edit this by hand: `npm run setup` fills it in for you
# (and preserves these comments). See docs/setup.md. Editing directly is fine too.

# Google OAuth — Calendar (read/write events) + Gmail (send only; never reads your inbox).
# Plus basic identity (openid/email) — no data access; it only lets the token say which
# account it is, so setup can autofill GOOGLE_USER_EMAIL below.
# Get a Client ID + Secret from a free OAuth "Desktop app" client — docs/setup.md, Step 1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Minted for you by `npm run setup` (or `npm run auth`). Heads-up: publish your
# OAuth app or Google expires this after 7 days — docs/setup.md → "The 7-day trap".
GOOGLE_REFRESH_TOKEN=
# Your own address — reflections are sent to/from here (setup autofills it)
GOOGLE_USER_EMAIL=

# No LLM key here on purpose: joshua421 makes no model calls of its own. The
# reflecting happens in YOUR assistant (Claude Desktop / ChatGPT / a local LLM /
# any MCP-capable client) — bring whichever provider you like.

# Where the behaviour log (records only) lives on this machine
JOSHUA421_DB=./joshua421.sqlite
# Your goals / grounding — the one piece of content stored (yours, editable by hand)
GROUNDING_PATH=./grounding.md
# Your REAL event calendar — the day joshua421 reads and annotates in place.
# Defaults to your primary calendar; kept distinct from the store calendar below.
JOSHUA421_READ_CALENDAR_ID=primary
# Calendar used as joshua421's store (the "calendar as database") — where CREATED
# artifacts (day summaries, later rollups) live. A dedicated "joshua421" calendar is
# cleanest — create it once and paste its id here; defaults to your primary calendar.
# Either way it's your own calendar; we store nothing.
JOSHUA421_CALENDAR_ID=primary

# When the daily nudges fire (hour of day, 0–23). Defaults 07:00 / 20:00. Change
# these, then re-run `npm run worker:install` to reschedule the launchd agents.
# JOSHUA421_MORNING_HOUR=7
# JOSHUA421_EVENING_HOUR=20
